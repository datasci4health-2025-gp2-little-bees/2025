		<properties node_id="4" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 1, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x1f\x00\x00\x06\xff\x00\x00\x04_\x00\x00\x00\x00\x00\x00\x00;\x00\x00\x06\xff\x00\x00\x04_\x00\x00\x00\x00\x02\x00\x00\x00\x07\x00\x00\x00\x00\x00\x00\x00\x00;\x00\x00\x06\xff\x00\x00\x04_', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable, StringVariable\n\ndomain = Domain([], metas=[\n    StringVariable("Motivo"),\n    StringVariable("Modulo"),\n    StringVariable("Target_id"),\n    StringVariable("relacao_conserv_dmel"),\n    StringVariable("status"),\n    StringVariable("Gene_Symbol"),\n])\n\nt1 = in_datas[0]\nt2 = in_datas[1]\n# Extrai as colunas específicas da tabela de entrada\nmetas = [[\n    row["Motivo"],\n    row["Modulo"],\n    row["Target_id"],\n    row["relacao_conserv_dmel"],\n    row["status"],\n    row["Gene_Symbol"],\n] for row in t1]\n\n# Converte para NumPy array\nimport numpy as np\nmetas = np.array(metas, dtype=object)\n\n# Cria tabela de saída\nX_empty = np.empty((len(metas), 0))  # sem atributos numéricos\nout_data = Table.from_numpy(ddomain, X_empty, metas=metas)', 'filename': None}, {'name': 'Filter Genes', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, StringVariable\n\n# Define o domínio (mesmo que o original)\ndomain = Domain([], metas=[\n    StringVariable("Motivo"),\n    StringVariable("Modulo"),\n    StringVariable("Target_id"),\n    StringVariable("relacao_conserv_dmel"),\n    StringVariable("status"),\n    StringVariable("Gene_Symbol"),\n])\n\n# Entrada: t1 = tabela principal, t2 = tabela de referência\nt1 = in_datas[0]\nt2 = in_datas[1]\n\n# Conjunto com todos os Gene_Symbols de t2\ngene_symbols_ref = set(str(row["Gene_Symbol"]) for row in t2)\n\n# Filtra apenas as linhas de t1 cujo Gene_Symbol aparece em t2\nfiltered_rows = [\n    row for row in t1 if str(row["Gene_Symbol"]) in gene_symbols_ref\n]\n\n# Extrai apenas as colunas desejadas das linhas filtradas\nmetas = [[\n    row["Motivo"],\n    row["Modulo"],\n    row["Target_id"],\n    row["relacao_conserv_dmel"],\n    row["status"],\n    row["Gene_Symbol"],\n] for row in filtered_rows]\n\n# Converte para numpy array\nmetas = np.array(metas, dtype=object)\nX_empty = np.empty((len(metas), 0))  # sem atributos numéricos\n\n# Cria tabela de saída\nout_data = Table.from_numpy(domain, X_empty, metas=metas)\n', 'filename': None}], 'scriptText': 'import numpy as np\nfrom Orange.data import Table, Domain, StringVariable\n\n# Define o domínio (mesmo que o original)\ndomain = Domain([], metas=[\n    StringVariable("Motivo"),\n    StringVariable("Modulo"),\n    StringVariable("Target_id"),\n    StringVariable("relacao_conserv_dmel"),\n    StringVariable("status"),\n    StringVariable("Gene_Symbol"),\n])\n\n# Entrada: t1 = tabela principal, t2 = tabela de referência\nt1 = in_datas[0]\nt2 = in_datas[1]\n\n# Conjunto com todos os Gene_Symbols de t2\ngene_symbols_ref = set(str(row["Gene_Symbol"]) for row in t2)\n\n# Filtra apenas as linhas de t1 cujo Gene_Symbol aparece em t2\nfiltered_rows = [\n    row for row in t1 if str(row["Gene_Symbol"]) in gene_symbols_ref\n]\n\n# Extrai apenas as colunas desejadas das linhas filtradas\nmetas = [[\n    row["Motivo"],\n    row["Modulo"],\n    row["Target_id"],\n    row["relacao_conserv_dmel"],\n    row["status"],\n    row["Gene_Symbol"],\n] for row in filtered_rows]\n\n# Converte para numpy array\nmetas = np.array(metas, dtype=object)\nX_empty = np.empty((len(metas), 0))  # sem atributos numéricos\n\n# Cria tabela de saída\nout_data = Table.from_numpy(domain, X_empty, metas=metas)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa8\x00\x00\x00h\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
